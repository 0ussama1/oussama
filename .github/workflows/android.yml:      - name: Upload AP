
name: Build APK

on: [push]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      # تحديث إلى v4 لضمان التوافق
      - uses: actions/checkout@v4

      - name: Build with Buildozer
        # تصحيح الاسم: ArtemSerebrennikov
        uses: ArtemSerebrennikov/buildozer-action@v1
        with:
          workdir: .
          buildozer_version: master

      - name: Upload APK
        # تحديث إلى v4 لحل مشكلة الخطأ التي ظهرت في الصورة
        uses: actions/upload-artifact@v4
        with:
          name: OussamaSat-APK
          path: bin/*.apk
